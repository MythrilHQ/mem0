OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
GOOGLE_API_KEY=          # Gemini (also accepts GEMINI_API_KEY)

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
APP_DB_NAME=mem0_app

# Traefik ingress hostnames (bare domains, no scheme). Used by the compose
# router Host() rules and to derive the public URLs below.
MEM0_SERVER_HOST=
MEM0_DASHBOARD_HOST=

# Public URLs. In the deploy workflow these default to https://<host> from the
# vars above; set explicitly here for local runs. DASHBOARD_URL is also the
# server's CORS allow-origin, so it must match where the dashboard is served.
DASHBOARD_URL=
NEXT_PUBLIC_API_URL=

# Provider selection. Defaults to OpenAI. Set to "gemini" to use Google Gemini
# (requires GOOGLE_API_KEY). Provider must be in BUNDLED_*_PROVIDERS (server/main.py).
MEM0_LLM_PROVIDER=gemini
MEM0_EMBEDDER_PROVIDER=gemini

# Model + embedding dimension. If unset, sensible per-provider defaults apply:
#   gemini -> llm=gemini-3.5-flash, embedder=models/gemini-embedding-001, dims=768
#   openai -> llm=gpt-4.1-nano-2025-04-14, embedder=text-embedding-3-small, dims=1536
# MEM0_EMBEDDING_DIMS MUST match the pgvector column created on first run; do not
# change it against an existing database without recreating the collection.
# MEM0_DEFAULT_LLM_MODEL=gemini-3.5-flash
# MEM0_DEFAULT_EMBEDDER_MODEL=models/gemini-embedding-001
# MEM0_EMBEDDING_DIMS=768

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
